CONFIG["DATA_DIR"].mkdir(exist_ok=True)
CONFIG["PUBLIC_DIR"].mkdir(exist_ok=True)

CODES_FILE    = CONFIG["DATA_DIR"] / "codes.json"
SESSIONS_FILE = CONFIG["DATA_DIR"] / "sessions.json"
SALES_FILE    = CONFIG["DATA_DIR"] / "sales.json"

# ============================================================
# أدوات مساعدة
# ============================================================
def read_json(path, fallback):
    try:
        if not path.exists(): return fallback
        with open(path, "r", encoding="utf-8") as f:
            return json.load(f)
    except Exception:
        return fallback

def write_json(path, data):
    with open(path, "w", encoding="utf-8") as f:
        json.dump(data, f, ensure_ascii=False, indent=2)

def now_ms():
    return int(time.time() * 1000)

def gen_code():
    raw = secrets.token_hex(CONFIG["CODE_LENGTH"] // 2).upper()
    return CONFIG["CODE_PREFIX"] + raw

# ============================================================
# Flask App
# ============================================================
app = Flask(__name__, static_folder=str(CONFIG["PUBLIC_DIR"]), static_url_path="")
app.secret_key = secrets.token_hex(32)

logging.basicConfig(level=logging.INFO, format="%(asctime)s [%(levelname)s] %(message)s")
log = logging.getLogger("SPIDER")

START_TIME = time.time()

# ============================================================
# API — الدخول والجلسات
# ============================================================
def require_session(f):
    @wraps(f)
    def wrapper(*args, **kwargs):
        token = request.headers.get("x-session") or request.args.get("token")
        sessions = read_json(SESSIONS_FILE, {})
        s = sessions.get(token)
        if not s or s.get("expires", 0) < now_ms():
            return jsonify({"status": "error", "error": "غير مصرح"}), 401
        s["lastSeen"] = now_ms()
        sessions[token] = s
        write_json(SESSIONS_FILE, sessions)
        request.spider_session = s
        return f(*args, **kwargs)
    return wrapper

@app.route("/api/login", methods=["POST"])
def api_login():
    data = request.get_json(silent=True) or {}
    code = (data.get("code") or "").strip()
    fingerprint = data.get("fingerprint") or request.remote_addr or ""

    if not code:
        return jsonify({"status": "error", "error": "الرجاء إدخال الكود"}), 400

    codes = read_json(CODES_FILE, {})
    entry = codes.get(code)

    if not entry:
        return jsonify({"status": "error", "error": "كود غير صالح"}), 401

    if entry.get("revoked"):
        return jsonify({"status": "error", "error": "تم إلغاء هذا الكود"}), 401

    if entry.get("expires", 0) < now_ms():
        return jsonify({"status": "error", "error": "انتهت صلاحية الكود"}), 401

    if entry.get("uses", 0) >= entry.get("maxUses", 1):
        return jsonify({"status": "error", "error": "تم استنفاد استخدامات الكود"}), 401

    if not entry.get("boundTo"):
        entry["boundTo"] = fingerprint
        entry["boundAt"] = now_ms()
    elif entry["boundTo"] != fingerprint:
        return jsonify({"status": "error", "error": "هذا الكود مستخدم على جهاز آخر"}), 401

    entry["uses"] = entry.get("uses", 0) + 1
    entry["lastUsed"] = now_ms()
    codes[code] = entry
    write_json(CODES_FILE, codes)

    token = secrets.token_hex(32)
    sessions = read_json(SESSIONS_FILE, {})
    sessions[token] = {
        "code": code,
        "ip": request.remote_addr,
        "created": now_ms(),
        "expires": entry["expires"],
        "lastSeen": now_ms(),
    }
    write_json(SESSIONS_FILE, sessions)

    log.info(f"[دخول] كود={code} ip={request.remote_addr} استخدامات={entry['uses']}/{entry['maxUses']}")

    return jsonify({
        "status": "ok",
        "token": token,
        "developer": CONFIG["DEVELOPER"],
        "remainingUses": entry["maxUses"] - entry["uses"],
    })

@app.route("/api/verify")
def api_verify():
    token = request.headers.get("x-session") or request.args.get("token")
    sessions = read_json(SESSIONS_FILE, {})
    s = sessions.get(token)
    if not s or s.get("expires", 0) < now_ms():
        return jsonify({"status": "error"}), 401
    return jsonify({"status": "ok", "developer": CONFIG["DEVELOPER"]})

@app.route("/api/logout", methods=["POST"])
def api_logout():
    token = request.headers.get("x-session") or (request.get_json(silent=True) or {}).get("token")
    sessions = read_json(SESSIONS_FILE, {})
    if token in sessions:
        del sessions[token]
        write_json(SESSIONS_FILE, sessions)
    return jsonify({"status": "ok"})

@app.route("/api/stats")
@require_session
def api_stats():
    return jsonify({
        "developer": CONFIG["DEVELOPER"],
        "total_accounts": 0,
        "accounts": [],
        "logs": [],
        "total_matches": 0,
        "total_matches_started": 0,
        "total_active_matches": 0,
        "total_gained_exp": 0,
        "exp_per_hour": 0,
        "uptime": int(time.time() - START_TIME),
    })

# ============================================================
# إنشاء كود
# ============================================================
def create_code(max_uses=1, days=7, owner=None, package=None):
    code = gen_code()
    codes = read_json(CODES_FILE, {})
    codes[code] = {
        "code": code,
        "uses": 0,
        "maxUses": max_uses,
        "expires": now_ms() + days * 24 * 3600 * 1000,
        "created": now_ms(),
        "owner": owner,
        "package": package,
        "boundTo": None,
        "revoked": False,
    }
    write_json(CODES_FILE, codes)
    return code

# ============================================================
# بوت تلجرام — أوامر عربية
# ============================================================
