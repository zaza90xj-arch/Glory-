def is_admin(update_or_chat_id) -> bool:
    """التحقق إن المستخدم أدمن"""
    if hasattr(update_or_chat_id, "effective_chat"):
        return update_or_chat_id.effective_chat.id == CONFIG["ADMIN_CHAT_ID"]
    return update_or_chat_id == CONFIG["ADMIN_CHAT_ID"]


def kb_main_menu():
    """القائمة الرئيسية للمستخدم"""
    return InlineKeyboardMarkup([
        [InlineKeyboardButton("🛒 شراء كود دخول", callback_data="shop")],
        [InlineKeyboardButton("📖 المساعدة", callback_data="help_user")],
    ])


def kb_admin_panel():
    """لوحة التحكم للأدمن"""
    return InlineKeyboardMarkup([
        [InlineKeyboardButton("🎟️ توليد كود جديد", callback_data="admin_gencode")],
        [InlineKeyboardButton("📋 الأكواد النشطة", callback_data="admin_codes")],
        [InlineKeyboardButton("💰 تقرير المبيعات", callback_data="admin_sales")],
        [InlineKeyboardButton("📊 إحصائيات النظام", callback_data="admin_stats")],
        [InlineKeyboardButton("👥 الجلسات النشطة", callback_data="admin_sessions")],
        [InlineKeyboardButton("🔒 إلغاء كود", callback_data="admin_revoke_menu")],
    ])


def kb_back_menu(is_admin_menu=False):
    """زر الرجوع"""
    target = "admin_panel" if is_admin_menu else "back_main"
    label = "🔙 رجوع للوحة التحكم" if is_admin_menu else "🔙 رجوع"
    return InlineKeyboardMarkup([[InlineKeyboardButton(label, callback_data=target)]])


def kb_shop():
    """قائمة الباقات"""
    rows = []
    for key, pkg in CONFIG["PACKAGES"].items():
        rows.append([InlineKeyboardButton(
            f"{pkg['name']} — {pkg['stars']} ⭐ ({pkg['days']} يوم)",
            callback_data=f"buy:{key}"
        )])
    rows.append([InlineKeyboardButton("🔙 رجوع", callback_data="back_main")])
    return InlineKeyboardMarkup(rows)


