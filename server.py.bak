# /start
# ============================================================
async def cmd_start(update: Update, ctx: ContextTypes.DEFAULT_TYPE):
    chat_id = update.effective_chat.id

    if is_admin(chat_id):
        await update.message.reply_text(
            f"👋 <b>أهلاً بك يا أدمن</b>\n"
            f"👨‍💻 المطور: <b>{CONFIG['DEVELOPER']}</b>\n\n"
            f"اختر من الأزرار أدناه:",
            parse_mode="HTML",
            reply_markup=kb_admin_panel()
        )
    else:
        await update.message.reply_text(
            f"👋 <b>أهلاً بك في SPIDER</b>\n"
            f"👨‍💻 المطور: <b>{CONFIG['DEVELOPER']}</b>\n\n"
            f"اختر من الأزرار أدناه:",
            parse_mode="HTML",
            reply_markup=kb_main_menu()
        )


# ============================================================
# معالج الأزرار الموحد
# ============================================================
async def on_button(update: Update, ctx: ContextTypes.DEFAULT_TYPE):
    q = update.callback_query
    await q.answer()
    data = q.data
    chat_id = q.message.chat.id
    admin = is_admin(chat_id)

    # --- أزرار المستخدم ---
    if data == "back_main":
        await q.edit_message_text(
            f"👋 <b>أهلاً بك في SPIDER</b>\n👨‍💻 المطور: <b>{CONFIG['DEVELOPER']}</b>\n\nاختر من الأزرار أدناه:",
            parse_mode="HTML",
            reply_markup=kb_main_menu()
        )
        return

    if data == "help_user":
        await q.edit_message_text(
            f"📖 <b>كيف تشتري كود؟</b>\n\n"
            f"1️⃣ اضغط <b>🛒 شراء كود دخول</b>\n"
            f"2️⃣ اختر الباقة\n"
            f"3️⃣ ادفع بالنجوم ⭐\n"
            f"4️⃣ سيصلك الكود هنا\n"
            f"5️⃣ اذهب للموقع وأدخل الكود\n\n"
            f"👨‍💻 المطور: <b>{CONFIG['DEVELOPER']}</b>",
            parse_mode="HTML",
            reply_markup=kb_back_menu(False)
        )
        return

    if data == "shop":
        await q.edit_message_text(
            f"🛒 <b>اختر الباقة المناسبة:</b>\n\n"
            f"الدفع يتم عبر <b>نجوم تلجرام</b> ⭐\n"
            f"👨‍💻 المطور: <b>{CONFIG['DEVELOPER']}</b>",
            parse_mode="HTML",
            reply_markup=kb_shop()
        )
        return

    if data.startswith("buy:"):
        key = data.split(":", 1)[1]
        pkg = CONFIG["PACKAGES"].get(key)
        if not pkg:
            await q.edit_message_text("❌ الباقة غير موجودة", reply_markup=kb_back_menu(False))
            return

        await ctx.bot.send_invoice(
            chat_id=chat_id,
            title=pkg["name"],
            description=pkg["desc"],
            payload=f"pkg:{key}",
            provider_token="",
            currency="XTR",
            prices=[LabeledPrice(label=pkg["name"], amount=pkg["stars"])],
        )
        await q.answer("💳 جارٍ فتح الدفع...", show_alert=False)
        return

    # --- حماية: كل الأزرار اللي تحت دي للأدمن فقط ---
    if not admin:
        await q.edit_message_text(
            f"⛔ <b>غير مصرح</b>\n\n"
            f"هذا الزر مخصص للأدمن فقط.\n"
            f"معرفك: <code>{chat_id}</code>",
            parse_mode="HTML",
            reply_markup=kb_main_menu()
        )
        return

    # --- أزرار الأدمن ---
    if data == "admin_panel":
        await q.edit_message_text(
            f"👋 <b>لوحة التحكم</b>\n👨‍💻 المطور: <b>{CONFIG['DEVELOPER']}</b>\n\nاختر:",
            parse_mode="HTML",
            reply_markup=kb_admin_panel()
        )
        return

    if data == "admin_gencode":
        # طلب إعدادات الكود
        await q.edit_message_text(
            f"🎟️ <b>توليد كود جديد</b>\n\n"
            f"اختر نوع الكود:",
            parse_mode="HTML",
            reply_markup=InlineKeyboardMarkup([
                [InlineKeyboardButton("⚡ كود سريع (استخدام 1، 7 أيام)", callback_data="gencode:1:7")],
                [InlineKeyboardButton("📅 أسبوعي (1 استخدام، 7 أيام)", callback_data="gencode:1:7")],
                [InlineKeyboardButton("📆 شهري (1 استخدام، 30 يوم)", callback_data="gencode:1:30")],
                [InlineKeyboardButton("📅 3 شهور (1 استخدام، 90 يوم)", callback_data="gencode:1:90")],
                [InlineKeyboardButton("👥 فريق (4 استخدامات، 30 يوم)", callback_data="gencode:4:30")],
                [InlineKeyboardButton("✏️ مخصص...", callback_data="gencode:custom")],
                [InlineKeyboardButton("🔙 رجوع", callback_data="admin_panel")],
            ])
        )
        return

    if data.startswith("gencode:"):
        parts = data.split(":")
        if parts[1] == "custom":
            await q.edit_message_text(
                f"✏️ <b>كود مخصص</b>\n\n"
                f"ابعت الأمر التالي في الشات:\n"
                f"<code>/gencode [عدد الاستخدامات] [عدد الأيام]</code>\n\n"
                f"مثال: <code>/gencode 5 30</code>\n"
                f"(5 استخدامات، 30 يوم)",
                parse_mode="HTML",
                reply_markup=kb_back_menu(True)
            )
            return

        uses = int(parts[1])
        days = int(parts[2])
        code = create_code(max_uses=uses, days=days, owner="admin")

        await q.edit_message_text(
            f"✅ <b>تم توليد الكود</b>\n\n"
            f"<code>{code}</code>\n\n"
            f"📊 الاستخدامات: <b>{uses}</b>\n"
            f"⏱️ الصلاحية: <b>{days} يوم</b>\n\n"
            f"👨‍💻 المطور: <b>{CONFIG['DEVELOPER']}</b>",
            parse_mode="HTML",
            reply_markup=InlineKeyboardMarkup([
                [InlineKeyboardButton("🔄 توليد آخر", callback_data="admin_gencode")],
                [InlineKeyboardButton("🔙 لوحة التحكم", callback_data="admin_panel")],
            ])
        )
        return

    if data == "admin_codes":
        codes = read_json(CODES_FILE, {})
        active = [c for c in codes.values() if not c.get("revoked") and c["expires"] > now_ms() and c["uses"] < c["maxUses"]]

        if not active:
            await q.edit_message_text(
                f"📭 <b>لا توجد أكواد نشطة</b>",
                parse_mode="HTML",
                reply_markup=kb_back_menu(True)
            )
            return

        lines = [f"📋 <b>الأكواد النشطة ({len(active)}):</b>\n"]
        for c in active[-15:]:
            d = time.strftime("%Y-%m-%d", time.localtime(c["expires"] / 1000))
            lines.append(f"<code>{c['code']}</code>\n  └ {c['uses']}/{c['maxUses']} استخدام — ينتهي {d}")

        await q.edit_message_text(
            "\n\n".join(lines),
            parse_mode="HTML",
            reply_markup=kb_back_menu(True)
        )
        return

    if data == "admin_sales":
        sales = read_json(SALES_FILE, [])
        if not sales:
            await q.edit_message_text(
                f"📭 <b>لا توجد مبيعات بعد</b>",
                parse_mode="HTML",
                reply_markup=kb_back_menu(True)
            )
            return

        total_stars = sum(s["stars"] for s in sales)
        lines = [
            f"💰 <b>تقرير المبيعات</b>\n",
            f"📊 إجمالي المبيعات: <b>{len(sales)}</b>",
            f"⭐ إجمالي النجوم: <b>{total_stars}</b>\n",
            f"<b>آخر 10 عمليات:</b>\n",
        ]
        for s in sales[-10:]:
            pkg_name = CONFIG["PACKAGES"].get(s["package"], {}).get("name", s["package"])
            uname = s.get("username") or s["user_id"]
            lines.append(f"• {pkg_name} — {s['stars']}⭐ — @{uname}")

        await q.edit_message_text(
            "\n".join(lines),
            parse_mode="HTML",
            reply_markup=kb_back_menu(True)
        )
        return

    if data == "admin_stats":
        codes = read_json(CODES_FILE, {})
        sales = read_json(SALES_FILE, [])
        sessions = read_json(SESSIONS_FILE, {})
        active_codes = len([c for c in codes.values() if not c.get("revoked") and c["expires"] > now_ms() and c["uses"] < c["maxUses"]])
        active_sess = len([s for s in sessions.values() if s["expires"] > now_ms()])
        total_stars = sum(s["stars"] for s in sales)
        uptime = int(time.time() - START_TIME)

        await q.edit_message_text(
            f"📊 <b>إحصائيات النظام</b>\n\n"
            f"🎟️ أكواد نشطة: <b>{active_codes}</b>\n"
            f"🔓 جلسات نشطة: <b>{active_sess}</b>\n"
            f"💰 مبيعات: <b>{len(sales)}</b>\n"
            f"⭐ إجمالي النجوم: <b>{total_stars}</b>\n"
            f"⏱️ مدة التشغيل: <b>{uptime // 60} دقيقة</b>\n\n"
            f"👨‍💻 المطور: <b>{CONFIG['DEVELOPER']}</b>",
            parse_mode="HTML",
            reply_markup=kb_back_menu(True)
        )
        return

    if data == "admin_sessions":
        sessions = read_json(SESSIONS_FILE, {})
        active = [s for s in sessions.values() if s["expires"] > now_ms()]

        if not active:
            await q.edit_message_text(
                f"📭 <b>لا توجد جلسات نشطة</b>",
                parse_mode="HTML",
                reply_markup=kb_back_menu(True)
            )
            return

        lines = [f"👥 <b>الجلسات النشطة ({len(active)}):</b>\n"]
        for s in active[-10:]:
            t = time.strftime("%Y-%m-%d %H:%M", time.localtime(s["created"] / 1000))
            lines.append(f"🎟️ <code>{s['code'][:20]}</code>\n  └ IP: {s.get('ip', '—')}\n  └ آخر ظهور: {t}")

        await q.edit_message_text(
            "\n\n".join(lines),
            parse_mode="HTML",
            reply_markup=kb_back_menu(True)
        )
        return

    if data == "admin_revoke_menu":
        codes = read_json(CODES_FILE, {})
        active = [c for c in codes.values() if not c.get("revoked") and c["expires"] > now_ms()]

        if not active:
            await q.edit_message_text(
                f"📭 <b>لا توجد أكواد لإلغائها</b>",
                parse_mode="HTML",
                reply_markup=kb_back_menu(True)
            )
            return

        rows = []
        for c in active[-10:]:
            rows.append([InlineKeyboardButton(
                f"🔒 {c['code'][:24]}...",
                callback_data=f"revoke:{c['code']}"
            )])
        rows.append([InlineKeyboardButton("🔙 رجوع", callback_data="admin_panel")])

        await q.edit_message_text(
            f"🔒 <b>اختر كود لإلغائه:</b>",
            parse_mode="HTML",
            reply_markup=InlineKeyboardMarkup(rows)
        )
        return

    if data.startswith("revoke:"):
        code = data.split(":", 1)[1]
        codes = read_json(CODES_FILE, {})
        if code not in codes:
            await q.edit_message_text(
                f"❌ الكود غير موجود",
                reply_markup=kb_back_menu(True)
            )
            return
        codes[code]["revoked"] = True
        write_json(CODES_FILE, codes)
        await q.edit_message_text(
            f"✅ <b>تم إلغاء الكود</b>\n\n"
            f"<code>{code}</code>\n\n"
            f"👨‍💻 المطور: <b>{CONFIG['DEVELOPER']}</b>",
            parse_mode="HTML",
            reply_markup=kb_back_menu(True)
        )
        return

    # لو الزر مش معروف
    await q.edit_message_text(
        f"❓ زر غير معروف",
        reply_markup=kb_admin_panel() if admin else kb_main_menu()
    )


# ============================================================
# دفع
# ============================================================
async def on_precheckout(update: Update, ctx: ContextTypes.DEFAULT_TYPE):
    q = update.pre_checkout_query
    await q.answer(ok=True)


async def on_paid(update: Update, ctx: ContextTypes.DEFAULT_TYPE):
    msg = update.message
    payload = msg.successful_payment.invoice_payload
    key = payload.split(":", 1)[1]
    pkg = CONFIG["PACKAGES"].get(key)
    if not pkg:
        return

    user = msg.from_user
    code = create_code(
        max_uses=pkg["uses"],
        days=pkg["days"],
        owner=user.id,
        package=key
    )

    sales = read_json(SALES_FILE, [])
    sales.append({
        "user_id": user.id,
        "username": user.username,
        "code": code,
        "package": key,
        "stars": pkg["stars"],
        "time": now_ms(),
    })
    write_json(SALES_FILE, sales)

    await msg.reply_text(
        f"✅ <b>تم الدفع بنجاح!</b>\n\n"
        f"🎟️ كود الدخول الخاص بك:\n"
        f"<code>{code}</code>\n\n"
        f"📊 عدد الاستخدامات: <b>{pkg['uses']}</b>\n"
        f"⏱️ صالح لمدة: <b>{pkg['days']} يوم</b>\n\n"
        f"➡️ اذهب إلى الموقع وأدخل هذا الكود.\n"
        f"👨‍💻 المطور: <b>{CONFIG['DEVELOPER']}</b>",
        parse_mode="HTML",
        reply_markup=kb_main_menu()
    )

    try:
        await ctx.bot.send_message(
            CONFIG["ADMIN_CHAT_ID"],
            f"💰 <b>عملية بيع جديدة!</b>\n"
            f"👤 المستخدم: @{user.username or user.id}\n"
            f"📦 الباقة: {pkg['name']}\n"
            f"⭐ النجوم: {pkg['stars']}\n"
            f"🎟️ الكود: <code>{code}</code>",
            parse_mode="HTML"
        )
    except Exception:
        pass


# ============================================================
# أوامر الأدمن النصية (اختيارية للاستخدام السريع)
# ============================================================
async def cmd_gencode(update: Update, ctx: ContextTypes.DEFAULT_TYPE):
    if not is_admin(update):
        await update.message.reply_text(
            f"⛔ <b>غير مصرح</b>\n\nمعرفك: <code>{update.effective_chat.id}</code>\n\n"
            f"استخدم <b>/start</b> لرؤية الأزرار.",
            parse_mode="HTML"
        )
        return
    args = ctx.args or []
    uses = int(args[0]) if len(args) > 0 and args[0].isdigit() else CONFIG["DEFAULT_MAX_USES"]
    days = int(args[1]) if len(args) > 1 and args[1].isdigit() else CONFIG["DEFAULT_TTL_DAYS"]
    code = create_code(max_uses=uses, days=days, owner="admin")
    await update.message.reply_text(
        f"🎟️ <b>كود جديد</b>\n\n<code>{code}</code>\n\n"
        f"📊 الاستخدامات: <b>{uses}</b>\n⏱️ الأيام: <b>{days}</b>",
        parse_mode="HTML",
        reply_markup=kb_admin_panel()
    )


async def cmd_help(update: Update, ctx: ContextTypes.DEFAULT_TYPE):
    if is_admin(update):
        await update.message.reply_text(
            f"👋 <b>لوحة التحكم</b>",
            parse_mode="HTML",
            reply_markup=kb_admin_panel()
        )
    else:
        await update.message.reply_text(
            f"👋 <b>أهلاً بك في SPIDER</b>",
            parse_mode="HTML",
            reply_markup=kb_main_menu()
        )
# ============================================================
# خدمة index.html
# ============================================================
@app.route("/")
def index():
    p = CONFIG["PUBLIC_DIR"] / "index.html"
    if p.exists():
        return send_from_directory(CONFIG["PUBLIC_DIR"], "index.html")
    return "<h1>SPIDER — ضع ملف index.html في مجلد /public</h1>"

# ============================================================
# تشغيل البوت + السيرفر
# ============================================================
def run_telegram_bot():
    if CONFIG["BOT_TOKEN"].startswith("7123"):
        log.warning("[تلجرام] توكن البوت غير معدّ — البوت معطّل")
        return

    application = Application.builder().token(CONFIG["BOT_TOKEN"]).build()

    # أوامر
application.add_handler(CommandHandler("start", cmd_start))
application.add_handler(CommandHandler("help", cmd_help))
application.add_handler(CommandHandler("gencode", cmd_gencode))

# معالج كل الأزرار في دالة واحدة
application.add_handler(CallbackQueryHandler(on_button))

# الدفع
application.add_handler(PreCheckoutQueryHandler(on_precheckout))
application.add_handler(MessageHandler(filters.SUCCESSFUL_PAYMENT, on_paid))

    log.info("[تلجرام] جارٍ تشغيل البوت...")
    try:
        application.run_polling(
            allowed_updates=Update.ALL_TYPES,
            drop_pending_updates=True,
            close_loop=False
        )
    except Exception as e:
        log.error(f"[تلجرام] خطأ: {e}")

if __name__ == "__main__":
    # Flask في thread منفصل
    def run_flask():
        log.info(f"🚀 SPIDER يعمل على http://localhost:{CONFIG['PORT']}")
        log.info(f"👨‍💻 المطور: {CONFIG['DEVELOPER']}")
        app.run(host="0.0.0.0", port=CONFIG["PORT"], debug=False, use_reloader=False)

    threading.Thread(target=run_flask, daemon=True).start()

    # البوت في الـ main thread (لازم)
    import time as _t
    _t.sleep(1)  # نستنى Flask يقوم الأول
    run_telegram_bot()